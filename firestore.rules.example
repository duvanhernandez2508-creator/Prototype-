rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function ownsFarm(farmId) {
      return get(/databases/$(database)/documents/farms/$(farmId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && (userId == request.auth.uid || isAdmin());
      allow write: if isAdmin() || (userId == request.auth.uid && request.resource.data.role == resource.data.role);
    }
    match /farms/{farmId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.advisorIds.hasAny([request.auth.uid]) || isAdmin());
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }
    match /entries/{entryId} {
      allow read: if signedIn() && (ownsFarm(resource.data.farmId) || isAdmin());
      allow create: if signedIn() && ownsFarm(request.resource.data.farmId);
      allow update, delete: if signedIn() && (ownsFarm(resource.data.farmId) || isAdmin());
    }
    match /recommendations/{recommendationId} {
      allow read: if signedIn();
      allow create: if signedIn() && (role() == 'advisor' || isAdmin());
      allow update, delete: if signedIn() && (role() == 'advisor' || isAdmin());
    }
  }
}
